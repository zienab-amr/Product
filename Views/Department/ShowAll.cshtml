@model List<Product.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Departments</h2>
            <p class="text-muted mb-0">All registered departments</p>
        </div>

        <div class="d-flex align-items-center gap-3">

            <span class="badge bg-primary fs-6">
                @Model.Count Departments
            </span>

            <a asp-controller="Department" asp-action="Add" class="btn btn-success"> Add Department </a>

        </div>

    </div>
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Department Name</th>
                    <th>Trainees Count</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var department in Model)
                {
                    <tr>
                        <td>@department.DepartmentId</td>

                        <td>
                            <strong>@department.Name</strong>
                        </td>

                        <td>
                            @department.Trainees.Count
                        </td>

                        <td>

                            <div class="d-flex gap-2">

                                <a asp-action="Details"
                                   asp-route-id="@department.DepartmentId"
                                   class="btn btn-sm btn-outline-primary rounded-pill">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@department.DepartmentId"
                                   class="btn btn-sm btn-outline-warning rounded-pill">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-controller="Department"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@department.DepartmentId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger rounded-pill"
                                            onclick="return confirm('Are you sure you want to delete this department?');">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>