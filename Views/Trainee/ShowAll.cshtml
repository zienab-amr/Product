@model List<Product.Models.Trainee>

@{
    ViewData["Title"] = "Trainees";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Trainees
            </h2>

            <p class="text-muted mb-0">
                All registered trainees
            </p>
        </div>

        <div class="d-flex align-items-center gap-3">

            <span class="badge bg-primary fs-6">
                @Model.Count Trainees
            </span>

            <a asp-controller="Trainee"
               asp-action="Add"
               class="btn btn-success">
                Add Trainee
            </a>

        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-dark text-white py-3">

            <h5 class="mb-0">
                Trainee List
            </h5>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>#</th>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var trainee in Model)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @trainee.TraineeId
                            </td>

                            <td>
                                <img src="~/Images/@trainee.Image"
                                     alt="@trainee.Name"
                                     width="50"
                                     height="50"
                                     class="rounded-circle object-fit-cover" />
                            </td>

                            <td>
                                <span class="fw-semibold">
                                    @trainee.Name
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @(trainee.Department?.Name ?? "No Department")
                                </span>
                            </td>

                            <td>

                                <div class="d-flex gap-2">

                                    <a asp-controller="Trainee"
                                       asp-action="Details"
                                       asp-route-id="@trainee.TraineeId"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        Details
                                    </a>

                                    <a asp-controller="Trainee"
                                       asp-action="Edit"
                                       asp-route-id="@trainee.TraineeId"
                                       class="btn btn-sm btn-outline-warning rounded-pill">
                                        Edit
                                    </a>

                                    <form asp-controller="Trainee"
                                          asp-action="Delete"
                                          method="post"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="id"
                                               value="@trainee.TraineeId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger rounded-pill"
                                                onclick="return confirm('Are you sure you want to delete this trainee?');">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>