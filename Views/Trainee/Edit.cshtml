@model Trainee

@{
    ViewData["Title"] = "Edit Trainee";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="bg-dark text-white text-center py-4">

                    <h3 class="fw-bold mb-1">
                        Edit Trainee
                    </h3>

                    <p class="mb-0 opacity-75">
                        Update Trainee Information
                    </p>

                </div>

                <div class="card-body p-5">

                    <form asp-action="Edit"
                          asp-controller="Trainee"
                          method="post"
                          enctype="multipart/form-data">

                        <input asp-for="TraineeId"
                               type="hidden" />

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                Trainee Name
                            </label>

                            <input asp-for="Name"
                                   type="text"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Image
                            </label>

                            <input name="imageFile"
                                   type="file"
                                   class="form-control" />

                        </div>

                        <div class="mb-4">

                            <label asp-for="DepartmentId"
                                   class="form-label">
                                Department
                            </label>

                            <select asp-for="DepartmentId"
                                    class="form-select">

                                <option value="">
                                    -- Select Department --
                                </option>

                                @foreach (var department in ViewBag.Departments)
                                {
                                    <option value="@department.DepartmentId">
                                        @department.Name
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="ShowAll"
                               class="btn btn-outline-dark">
                                Back
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>