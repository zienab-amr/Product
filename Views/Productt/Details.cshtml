@model Product.Models.Productt

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="row g-0">
            <div class="col-md-5 d-flex align-items-center justify-content-center p-4 bg-light">
                <img src="@Model.Image" class="img-fluid rounded" alt="@Model.Name" style="max-height: 400px; object-fit: contain;">
            </div>

            <div class="col-md-7">
                <div class="card-body p-5">

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="card-title fw-bold mb-0">@Model.Name</h2>
                        <span class="badge bg-secondary fs-6">@Model.Brand</span>
                    </div>

                    <p class="text-muted mb-4">Category: @Model.Category</p>

                    <h3 class="text-success fw-bold mb-4">@Model.Price EGP</h3>

                    <h5 class="fw-semibold">Description</h5>
                    <p class="card-text fs-5 text-secondary mb-4">@Model.Description</p>

                    <hr class="text-muted" />

                    <div class="row text-center mb-4 mt-4">
                        <div class="col">
                            <strong class="d-block mb-2">Stock</strong>
                            @if (Model.Stock > 0)
                            {
                                <span class="badge bg-success">In Stock (@Model.Stock)</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                        </div>
                        <div class="col">
                            <strong class="d-block mb-2">Rating</strong>
                            <span class="text-warning fs-5">
                                @for (int i = 0; i < Model.Rating; i++)
                                {
                                    <span>★</span>
                                }
                                @for (int i = Model.Rating; i < 5; i++)
                                {
                                    <span>☆</span>
                                }
                            </span>
                        </div>
                        <div class="col">
                            <strong class="d-block mb-2">Status</strong>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-primary">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-start mt-5">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                            Back to List
                        </a>
                        <button class="btn btn-primary px-4 py-2">
                            Add to Cart
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>